# SPDX-License-Identifier: MIT
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)

if(CMAKE_HOST_WIN32)
  set(xpack_exe_suffix ".exe")
else()
  set(xpack_exe_suffix "")
endif()
set(xpack_bin "" CACHE PATH "xPack RISC-V GCC bin directory (empty: found on PATH)")
if(xpack_bin STREQUAL "")
  set(xpack_prefix "")
else()
  set(xpack_prefix "${xpack_bin}/")
endif()
set(CMAKE_C_COMPILER ${xpack_prefix}riscv-none-elf-gcc${xpack_exe_suffix})
set(CMAKE_ASM_COMPILER ${xpack_prefix}riscv-none-elf-gcc${xpack_exe_suffix})
set(CMAKE_OBJCOPY ${xpack_prefix}riscv-none-elf-objcopy${xpack_exe_suffix} CACHE FILEPATH "")
set(CMAKE_SIZE ${xpack_prefix}riscv-none-elf-size${xpack_exe_suffix} CACHE FILEPATH "")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
