# SPDX-License-Identifier: MIT
if(NOT INPUT OR NOT OUTPUT)
  message(FATAL_ERROR "usage: cmake -DINPUT=<bootloader.bin> -DOUTPUT=<source.c> -P embed_bootloader.cmake")
endif()
set(sector_bytes 4096)

file(READ ${INPUT} hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR size "${hex_length} / 2")
if(size EQUAL 0 OR size GREATER sector_bytes)
  message(FATAL_ERROR "${INPUT}: ${size} bytes, bootloader must be 1 to ${sector_bytes} bytes")
endif()
math(EXPR partial "${size} % 4")
if(NOT partial EQUAL 0)
  message(FATAL_ERROR "${INPUT}: ${size} bytes is not whole 32-bit words")
endif()

string(REGEX MATCHALL ".." bytes "${hex}")
set(crc 4294967295)
foreach(byte IN LISTS bytes)
  math(EXPR crc "${crc} ^ 0x${byte}")
  foreach(bit RANGE 7)
    math(EXPR crc "(${crc} >> 1) ^ (0xEDB88320 & (0 - (${crc} & 1)))")
  endforeach()
endforeach()
math(EXPR crc "${crc} ^ 0xFFFFFFFF" OUTPUT_FORMAT HEXADECIMAL)
string(SUBSTRING "${crc}" 2 -1 crc_digits)
string(LENGTH "${crc_digits}" crc_length)
math(EXPR crc_padding "8 - ${crc_length}")
string(REPEAT "0" ${crc_padding} zeros)

set(words "")
set(line "")
set(index 0)
math(EXPR last_word "${size} / 4 - 1")
foreach(word RANGE ${last_word})
  math(EXPR first "${word} * 4")
  list(SUBLIST bytes ${first} 4 four)
  list(GET four 0 b0)
  list(GET four 1 b1)
  list(GET four 2 b2)
  list(GET four 3 b3)
  string(APPEND line " 0x${b3}${b2}${b1}${b0}u,")
  math(EXPR index "${index} + 1")
  math(EXPR column "${index} % 8")
  if(column EQUAL 0 OR word EQUAL last_word)
    string(APPEND words "   ${line}\n")
    set(line "")
  endif()
endforeach()
string(REPLACE ", \n" ",\n" words "${words}")
get_filename_component(input_name ${INPUT} NAME)

file(WRITE ${OUTPUT} "/*\n * SPDX-License-Identifier: MIT\n */\n\n"
                     "/* GENERATED by embed_bootloader.cmake from ${input_name} */\n\n"
                     "#include \"installer_image.h\"\n\n"
                     "const uint32_t installer_boot_words[] = {\n${words}};\n"
                     "const uint32_t installer_boot_size = ${size}u;\n"
                     "const uint32_t installer_boot_crc = 0x${zeros}${crc_digits}u;\n")
